{
  "name": "finance",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "db:reset": "node --env-file-if-exists=.env src/db/reset.ts",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.ts",
    "api:http": "node --env-file-if-exists=.env src/http/api.ts",
    "mcp:http": "node --env-file-if-exists=.env src/mcp/http.ts",
    "mcp:stdio": "node --env-file-if-exists=.env src/mcp/stdio.ts",
    "mcp:demo": "node --env-file-if-exists=.env src/mcp/demo.ts",
    "typecheck": "tsc",
    "check": "biome ci && tsc && tsc -p web",
    "fix": "biome check --write",
    "test": "node --env-file-if-exists=.env --test 'test/**/*.test.ts' && npm test -w web",
    "test:coverage": "node --env-file-if-exists=.env --test --experimental-test-coverage --test-coverage-exclude='test/**' 'test/**/*.test.ts' && npm test -w web",
    "ingest:test": "uv --directory ingest run pytest",
    "ingest:check": "uv --directory ingest run ruff check && uv --directory ingest run ruff format --check",
    "web:dev": "npm run dev -w web --",
    "web:build": "npm run build -w web --",
    "openapi": "node src/http/document.ts && node web/scripts/openapi-types.ts",
    "agent:schema": "node src/import/schema.ts",
    "web:screenshots": "npm run screenshots -w web --",
    "import": "node --env-file-if-exists=.env src/import/cli.ts",
    "eval": "node src/eval/run.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "pg": "^8.23.1",
    "read-excel-file": "9.3.12",
    "zod": "^4.6.7"
  }
}
