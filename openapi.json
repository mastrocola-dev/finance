          "paid": {
            "$ref": "#/components/schemas/Money"
          },
          "pending": {
            "$ref": "#/components/schemas/Money"
          },
          "late": {
            "$ref": "#/components/schemas/Money"
          }
        },
        "required": [
          "category",
          "count",
          "total",
          "paid",
          "pending",
          "late"
        ],
        "additionalProperties": false
      },
      "Side": {
