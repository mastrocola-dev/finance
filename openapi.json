          "category": {
            "type": "string"
          },
          "account": {
            "type": [
              "string",
              "null"
            ]
          },
          "member": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "paid",
              "late"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "paid",
              "pending",
              "late"
            ]
          },
          "paidOn": {
            "anyOf": [
              {
                "type": "string",
                "description": "Date as YYYY-MM-DD"
              },
              {
                "type": "null"
              }
            ]
          },
          "installmentNumber": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "competence",
          "dueOn",
          "description",
          "direction",
          "amount",
          "category",
          "account",
          "member",
          "status",
          "state",
          "paidOn",
          "installmentNumber"
