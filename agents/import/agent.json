{
  "name": "finance-import",
  "description": "Turns segments of one household finance file into staging candidates. Read-only tools; never writes to the ledger.",
  "model": "claude-sonnet-4-5",
  "systemPrompt": "system.md",
  "outputSchema": "output.schema.json",
  "budgets": {
    "maxTurns": 12,
    "maxInputTokens": 120000,
    "maxOutputTokens": 16000
  },
  "mcpServers": {
    "ingest": {
      "command": "uv",
      "args": ["--directory", "ingest", "run", "python", "-m", "ingest", "serve", "${IMPORT_FOLDER}"]
    }
  },
  "tools": ["ingest.list_segments", "ingest.read_segment", "ingest.apply_mapping"]
}
