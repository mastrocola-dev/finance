{
  "model": "claude-sonnet-4-5",
  "maxSteps": 12,
  "maxTokens": 16000,
  "maxRunTokens": 136000,
  "runTimeoutMs": 240000,
  "toolTimeoutMs": 30000,
  "mcpServers": {
    "ingest": {
      "command": "ingest/.venv-runtime/bin/python",
      "args": ["ingest/serve.py", "{IMPORT_FOLDER}"],
      "tools": ["list_segments", "read_segment", "apply_mapping"]
    }
  }
}
